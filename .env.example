# ─────────────────────────────────────────────────────────────────────────────
# TraceLens — Environment Variables Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Application Environment
NODE_ENV=development
PORT=3001

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://tracelens:tracelens_dev_pw@localhost:5432/tracelens
POSTGRES_USER=tracelens
POSTGRES_PASSWORD=tracelens_dev_pw
POSTGRES_DB=tracelens

# API Security & Rate Limiting
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=500

# Background Worker & Alert Evaluation
ALERT_EVAL_INTERVAL_SECONDS=30
DEPLOYMENT_LOOKBACK_MINUTES=60

# Safe Fault Injection (Enabled only in development/test for Replay Lab)
ENABLE_FAULT_INJECTION=true

# Telemetry Backends
PROMETHEUS_BASE_URL=http://localhost:9090
LOKI_BASE_URL=http://localhost:3100
TEMPO_BASE_URL=http://localhost:3200
GRAFANA_BASE_URL=http://localhost:3000

# OpenTelemetry Collector & Exporters
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Demo Microservices
ORDER_SERVICE_URL=http://localhost:3010
INVENTORY_SERVICE_URL=http://localhost:3011
