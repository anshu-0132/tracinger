FROM node:22-alpine AS base
WORKDIR /app
COPY package.json package-lock.json* ./
COPY apps/demo-inventory-service/package.json ./apps/demo-inventory-service/

FROM base AS deps
RUN npm ci --workspace=apps/demo-inventory-service --ignore-scripts

FROM deps AS builder
COPY apps/demo-inventory-service/src ./apps/demo-inventory-service/src
COPY apps/demo-inventory-service/tsconfig.json ./apps/demo-inventory-service/
COPY tsconfig.base.json ./
RUN npm run build --workspace=apps/demo-inventory-service

FROM node:22-alpine AS runner
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json
COPY --from=deps /app/apps/demo-inventory-service/package.json ./apps/demo-inventory-service/package.json
COPY --from=builder /app/apps/demo-inventory-service/dist ./apps/demo-inventory-service/dist

ENV NODE_ENV=production
EXPOSE 3011
CMD ["node", "apps/demo-inventory-service/dist/index.js"]
