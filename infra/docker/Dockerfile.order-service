FROM node:22-alpine AS base
WORKDIR /app
COPY package.json package-lock.json* ./
COPY apps/demo-order-service/package.json ./apps/demo-order-service/

FROM base AS deps
RUN npm ci --workspace=apps/demo-order-service --ignore-scripts

FROM deps AS builder
COPY apps/demo-order-service/src ./apps/demo-order-service/src
COPY apps/demo-order-service/tsconfig.json ./apps/demo-order-service/
COPY tsconfig.base.json ./
RUN npm run build --workspace=apps/demo-order-service

FROM node:22-alpine AS runner
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json
COPY --from=deps /app/apps/demo-order-service/package.json ./apps/demo-order-service/package.json
COPY --from=builder /app/apps/demo-order-service/dist ./apps/demo-order-service/dist

ENV NODE_ENV=production
EXPOSE 3010
CMD ["node", "apps/demo-order-service/dist/index.js"]
